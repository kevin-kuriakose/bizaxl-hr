{
    "name": "BA Leave Application",
    "doctype": "DocType",
    "module": "BizAxl HR",
    "autoname": "naming_series:",
    "naming_series": "LEA-.YYYY.-",
    "is_submittable": 1,
    "fields": [
        {"fieldname": "naming_series", "fieldtype": "Select", "options": "LEA-.YYYY.-"},
        {"fieldname": "employee", "fieldtype": "Link", "label": "Employee", "options": "BA Employee", "reqd": 1, "in_list_view": 1},
        {"fieldname": "employee_name", "fieldtype": "Data", "label": "Employee Name", "fetch_from": "employee.employee_name", "read_only": 1},
        {"fieldname": "leave_type", "fieldtype": "Link", "label": "Leave Type", "options": "BA Leave Type", "reqd": 1, "in_list_view": 1},
        {"fieldname": "col1", "fieldtype": "Column Break"},
        {"fieldname": "from_date", "fieldtype": "Date", "label": "From Date", "reqd": 1, "in_list_view": 1},
        {"fieldname": "to_date", "fieldtype": "Date", "label": "To Date", "reqd": 1, "in_list_view": 1},
        {"fieldname": "total_leave_days", "fieldtype": "Float", "label": "Total Days", "read_only": 1, "in_list_view": 1},
        {"fieldname": "half_day", "fieldtype": "Check", "label": "Half Day"},
        {"fieldname": "half_day_date", "fieldtype": "Date", "label": "Half Day Date"},
        {"fieldname": "reason", "fieldtype": "Small Text", "label": "Reason"},
        {"fieldname": "status", "fieldtype": "Select", "label": "Status",
         "options": "Draft\nOpen\nApproved\nRejected\nCancelled", "default": "Draft", "in_list_view": 1},
        {"fieldname": "leave_approver", "fieldtype": "Link", "label": "Leave Approver", "options": "User"}
    ],
    "permissions": [
        {"role": "System Manager", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1},
        {"role": "HR Manager", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1},
        {"role": "HR User", "read": 1, "write": 1, "create": 1},
        {"role": "Employee", "read": 1, "write": 1, "create": 1}
    ]
}
