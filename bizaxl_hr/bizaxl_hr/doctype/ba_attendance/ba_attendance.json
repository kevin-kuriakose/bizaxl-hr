{
    "name": "BA Attendance",
    "doctype": "DocType",
    "module": "BizAxl HR",
    "autoname": "naming_series:",
    "naming_series": "ATT-.YYYY.-",
    "is_submittable": 1,
    "fields": [
        {"fieldname": "naming_series", "fieldtype": "Select", "options": "ATT-.YYYY.-"},
        {"fieldname": "employee", "fieldtype": "Link", "label": "Employee", "options": "BA Employee", "reqd": 1, "in_list_view": 1},
        {"fieldname": "employee_name", "fieldtype": "Data", "label": "Employee Name", "fetch_from": "employee.employee_name", "read_only": 1},
        {"fieldname": "attendance_date", "fieldtype": "Date", "label": "Date", "reqd": 1, "in_list_view": 1},
        {"fieldname": "col1", "fieldtype": "Column Break"},
        {"fieldname": "status", "fieldtype": "Select", "label": "Status", "reqd": 1, "in_list_view": 1,
         "options": "Present\nAbsent\nHalf Day\nOn Leave\nWork From Home"},
        {"fieldname": "shift", "fieldtype": "Data", "label": "Shift"},
        {"fieldname": "in_time", "fieldtype": "Time", "label": "In Time"},
        {"fieldname": "out_time", "fieldtype": "Time", "label": "Out Time"},
        {"fieldname": "working_hours", "fieldtype": "Float", "label": "Working Hours", "read_only": 1},
        {"fieldname": "late_entry", "fieldtype": "Check", "label": "Late Entry"},
        {"fieldname": "early_exit", "fieldtype": "Check", "label": "Early Exit"},
        {"fieldname": "company", "fieldtype": "Link", "label": "Company", "options": "BA Company", "reqd": 1}
    ],
    "permissions": [
        {"role": "System Manager", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1},
        {"role": "HR Manager", "read": 1, "write": 1, "create": 1, "submit": 1},
        {"role": "HR User", "read": 1, "write": 1, "create": 1},
        {"role": "Employee", "read": 1}
    ]
}
