{
    "name": "BA Employee",
    "doctype": "DocType",
    "module": "BizAxl HR",
    "autoname": "naming_series:",
    "naming_series": "EMP-.YYYY.-",
    "title_field": "employee_name",
    "search_fields": "employee_name,department,designation",
    "fields": [
        {"fieldname": "naming_series", "fieldtype": "Select", "label": "Series", "options": "EMP-.YYYY.-"},
        {"fieldname": "employee_name", "fieldtype": "Data", "label": "Full Name", "reqd": 1, "in_list_view": 1},
        {"fieldname": "gender", "fieldtype": "Select", "label": "Gender", "options": "Male\nFemale\nOther", "in_list_view": 1},
        {"fieldname": "date_of_birth", "fieldtype": "Date", "label": "Date of Birth"},
        {"fieldname": "col1", "fieldtype": "Column Break"},
        {"fieldname": "company", "fieldtype": "Link", "label": "Company", "options": "BA Company", "reqd": 1},
        {"fieldname": "department", "fieldtype": "Link", "label": "Department", "options": "BA Department", "in_list_view": 1},
        {"fieldname": "designation", "fieldtype": "Link", "label": "Designation", "options": "BA Designation", "in_list_view": 1},
        {"fieldname": "employee_group", "fieldtype": "Link", "label": "Employee Group", "options": "BA Employee Group"},
        {"fieldname": "sec_join", "fieldtype": "Section Break", "label": "Employment"},
        {"fieldname": "date_of_joining", "fieldtype": "Date", "label": "Date of Joining", "reqd": 1},
        {"fieldname": "employment_type", "fieldtype": "Select", "label": "Employment Type",
         "options": "Full-time\nPart-time\nContract\nInternship\nFreelance"},
        {"fieldname": "notice_number_of_days", "fieldtype": "Int", "label": "Notice Period (Days)", "default": "30"},
        {"fieldname": "date_of_relieving", "fieldtype": "Date", "label": "Date of Relieving"},
        {"fieldname": "reason_for_leaving", "fieldtype": "Select", "label": "Reason for Leaving",
         "options": "\nResigned\nTerminated\nRetired\nContract Ended"},
        {"fieldname": "sec_contact", "fieldtype": "Section Break", "label": "Contact"},
        {"fieldname": "personal_email", "fieldtype": "Data", "label": "Personal Email", "options": "Email"},
        {"fieldname": "company_email", "fieldtype": "Data", "label": "Company Email", "options": "Email"},
        {"fieldname": "cell_number", "fieldtype": "Data", "label": "Mobile"},
        {"fieldname": "emergency_phone_number", "fieldtype": "Data", "label": "Emergency Contact"},
        {"fieldname": "sec_salary", "fieldtype": "Section Break", "label": "Salary"},
        {"fieldname": "ctc", "fieldtype": "Currency", "label": "CTC (Annual)"},
        {"fieldname": "salary_mode", "fieldtype": "Select", "label": "Salary Mode",
         "options": "Bank Transfer\nCash\nCheque"},
        {"fieldname": "bank_name", "fieldtype": "Data", "label": "Bank Name"},
        {"fieldname": "bank_account_no", "fieldtype": "Data", "label": "Bank Account No"},
        {"fieldname": "sec_id", "fieldtype": "Section Break", "label": "Identity"},
        {"fieldname": "pan_number", "fieldtype": "Data", "label": "PAN Number"},
        {"fieldname": "aadhaar_number", "fieldtype": "Data", "label": "Aadhaar Number"},
        {"fieldname": "pf_number", "fieldtype": "Data", "label": "PF Number"},
        {"fieldname": "esi_number", "fieldtype": "Data", "label": "ESI Number"},
        {"fieldname": "status", "fieldtype": "Select", "label": "Status",
         "options": "Active\nInactive\nSuspended\nLeft", "default": "Active", "in_list_view": 1},
        {"fieldname": "user_id", "fieldtype": "Link", "label": "User", "options": "User"}
    ],
    "permissions": [
        {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
        {"role": "HR Manager", "read": 1, "write": 1, "create": 1},
        {"role": "HR User", "read": 1, "write": 1},
        {"role": "Employee", "read": 1}
    ]
}
